# Node web app
APP_NAME=my-htmx-app
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend -> Python STT backend
STT_BACKEND_URL=http://localhost:8000

# Python backend -> Vosk service
VOSK_WS_URL=ws://localhost:2700
VOSK_LANGUAGE=en
VOSK_DEFAULT_MODEL=en
VOSK_WS_URL_EN=ws://localhost:2700
VOSK_WS_URL_SR=ws://localhost:2701
VOSK_WS_URL_SH=ws://localhost:2702

# Optional Docker build overrides for slavic models.
# Current defaults may 404 if upstream files are moved/removed.
VOSK_MODEL_URL_SR=https://alphacephei.com/vosk/models/vosk-model-small-sr-0.4.zip
VOSK_MODEL_DIRNAME_SR=vosk-model-small-sr-0.4
VOSK_MODEL_URL_SH=https://alphacephei.com/vosk/models/vosk-model-small-sh-0.4.zip
VOSK_MODEL_DIRNAME_SH=vosk-model-small-sh-0.4

# Optional GHCR image overrides for compose deployments.
FRONTEND_IMAGE=ghcr.io/kotaupwork/lis-stt/frontend:v1.5
BACKEND_IMAGE=ghcr.io/kotaupwork/lis-stt/backend:v1.5
