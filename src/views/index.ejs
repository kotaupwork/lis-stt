<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= appName %></title>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <link rel="stylesheet" href="/styles.css" />
    <script>
      window.STT_BACKEND_URL = "<%= sttBackendUrl %>";

      (() => {
        const storedTheme = localStorage.getItem("theme");
        const preferredDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const initialTheme = storedTheme ?? (preferredDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", initialTheme);
      })();

      window.toggleTheme = () => {
        const current = document.documentElement.getAttribute("data-theme") ?? "light";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      };
    </script>
    <script type="module" src="/stt.js"></script>
  </head>
  <body>
    <main class="container">
      <div class="toolbar">
        <button class="btn theme-toggle" onclick="window.toggleTheme()">
          Toggle Theme
        </button>
      </div>

      <h1><%= appName %></h1>
      <p>Server-rendered starter with htmx partial updates.</p>

      <section class="card">
        <h2>Speech-to-Text</h2>
        <div class="stt-info">
          <p>
            Mode: <span id="stt-mode" class="badge">Initializing...</span>
          </p>
          <div class="model-picker">
            <label for="model-select">Vosk Model</label>
            <select id="model-select" class="model-select">
              <option value="en" selected>English (kaldi-en)</option>
              <option value="en_small">English Small (vosk-model-small-en-us-0.15)</option>
              <option value="en_large">English Large (vosk-model-en-us-0.22)</option>
              <option value="sr">Serbian (vosk-model-small-sr-0.4)</option>
              <option value="sh">Serbo-Croatian (vosk-model-small-sh-0.4)</option>
            </select>
            <p id="model-hint" class="model-hint">Checking backend model availability...</p>

            <label for="sensitivity-select">Microphone Sensitivity</label>
            <select id="sensitivity-select" class="model-select">
              <option value="high">High (captures quieter speech)</option>
              <option value="balanced" selected>Balanced</option>
              <option value="low">Low (filters more background noise)</option>
            </select>
            <p id="sensitivity-hint" class="model-hint">
              Sensitivity controls Vosk audio gating and analysis window.
            </p>
          </div>
        </div>

        <button
          id="record-btn"
          class="btn btn-primary"
          onclick="window.sttAPI?.toggleRecording()"
        >
          🎤 Start Recording
        </button>

        <p id="stt-status" class="stt-status stt-status-info"></p>

        <div class="sample-audio-panel">
          <h3>Sample Audio Tests</h3>
          <p class="sample-audio-hint">
            These clips stream directly to the backend (Vosk path) so you can test
            STT behavior without a microphone.
          </p>

          <div class="sample-audio-grid">
            <div class="sample-audio-item">
              <strong>Serbian Female</strong>
              <audio controls src="/audio-samples/sr_female.mp3"></audio>
              <button
                class="btn sample-btn"
                onclick="window.sttAPI?.runSample('/audio-samples/sr_female.mp3', 'Serbian Female')"
              >
                Run Through STT
              </button>
            </div>

            <div class="sample-audio-item">
              <strong>Serbian Male</strong>
              <audio controls src="/audio-samples/sr_male.mp3"></audio>
              <button
                class="btn sample-btn"
                onclick="window.sttAPI?.runSample('/audio-samples/sr_male.mp3', 'Serbian Male')"
              >
                Run Through STT
              </button>
            </div>

            <div class="sample-audio-item">
              <strong>English Female</strong>
              <audio controls src="/audio-samples/en_female.mp3"></audio>
              <button
                class="btn sample-btn"
                onclick="window.sttAPI?.runSample('/audio-samples/en_female.mp3', 'English Female')"
              >
                Run Through STT
              </button>
            </div>

            <div class="sample-audio-item">
              <strong>English Male</strong>
              <audio controls src="/audio-samples/en_male.mp3"></audio>
              <button
                class="btn sample-btn"
                onclick="window.sttAPI?.runSample('/audio-samples/en_male.mp3', 'English Male')"
              >
                Run Through STT
              </button>
            </div>
          </div>
        </div>

        <div id="transcript-container" class="card transcript-box">
          <h3>Transcription</h3>
          <p id="transcript-interim" class="transcript-interim"></p>
          <div id="transcript-final" class="transcript-final"></div>
        </div>
      </section>
    </main>
  </body>
</html>
