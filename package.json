{
  "name": "my-htmx-project",
  "version": "0.1.0",
  "description": "Server-rendered htmx starter with TypeScript",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "node --watch --import tsx/esm src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ejs": "^3.1.10"
  }
}
